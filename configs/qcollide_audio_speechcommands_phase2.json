{
  "schema_version": 1,
  "dataset": "speech_commands_v0.02",
  "data_root": ".cache/qcollide-audio",
  "commands": ["yes", "no", "up", "down", "left", "right", "on", "off", "stop", "go", "zero", "one"],
  "architectures": ["audio_cnn", "wav2vec2", "ast"],
  "fixture_seeds": [20260811, 20260812, 20260813],
  "train_per_class": 80,
  "calibration_per_class": 24,
  "evaluation_per_class": 24,
  "target_samples": 16000,
  "feature_batch_size": 8,
  "cnn_hidden_dimension": 128,
  "cnn_epochs": 15,
  "cnn_batch_size": 64,
  "cnn_learning_rate": 0.001,
  "wav2vec2_model": "facebook/wav2vec2-base",
  "ast_model": "MIT/ast-finetuned-speech-commands-v2",
  "classifier_c": 1.0,
  "classifier_max_iter": 1000,
  "control_ridge_alpha": 1.0,
  "minimum_control_r2": 0.10,
  "minimum_evaluation_accuracy": 0.50,
  "anchors_per_class": 2,
  "visible_ranks": [1, 2, 4, 8],
  "control_quantile": 0.95,
  "payload_quantile": 0.95,
  "behavior_quantile": 0.95,
  "epsilon_multipliers": [0.25, 0.5, 0.75, 1.0, 1.5, 2.0, 3.0, 4.0],
  "torch_threads": 2
}
