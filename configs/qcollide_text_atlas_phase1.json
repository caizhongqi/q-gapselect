  "classifier_c": 1.0,
  "classifier_max_iter": 800,
  "control_ridge_alpha": 1.0,
  "visible_ranks": [1, 2, 4, 8],
  "control_quantile": 0.95,
  "payload_quantile": 0.95,
  "behavior_quantile": 0.95,
  "epsilon_multipliers": [0.25, 0.5, 0.75, 1.0, 1.5, 2.0, 3.0, 4.0]
}
